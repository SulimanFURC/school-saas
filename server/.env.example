PORT=5000
DB_NAME=school_saas
DB_USER=postgres
DB_PASS=yourpassword
DB_HOST=localhost
JWT_SECRET=supersecret

# Access token TTL (minutes) and refresh token TTL (days)
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Optional: separate pepper for hashing opaque refresh/reset tokens (defaults to JWT_SECRET)
# TOKEN_HASH_PEPPER=

# Forgot-password: token lifetime (minutes). In development or when PASSWORD_RESET_RETURN_TOKEN=true,
# API may include resetToken in JSON (do not enable return token in production).
PASSWORD_RESET_EXPIRES_MINUTES=60
PASSWORD_RESET_RETURN_TOKEN=true

# Max JSON body size for Express (large student photos); default 50mb in code if unset
JSON_BODY_LIMIT=50mb

# Bootstrap platform super admin (change after first login)
SUPER_ADMIN_PASSWORD=changeme
# Startup does not seed automatically. Run `npm run seed:bootstrap` when explicit bootstrap/backfill is required.

# Default password assigned to new student portal accounts when generated server-side
STUDENT_DEFAULT_PASSWORD=changeme

# Auth rate limits (requests per window per IP)
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_SIGNUP_MAX=20
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_PASSWORD_RESET_MAX=30
