PORT=5000
DB_NAME=school_saas
DB_USER=postgres
DB_PASS=yourpassword
DB_HOST=localhost
JWT_SECRET=supersecret

# Max JSON body size for Express (large student photos); default 50mb in code if unset
JSON_BODY_LIMIT=50mb

# Bootstrap platform super admin (change after first login)
SUPER_ADMIN_PASSWORD=changeme

# Default password assigned to new student portal accounts when generated server-side
STUDENT_DEFAULT_PASSWORD=changeme

# Auth rate limits (requests per window per IP)
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_SIGNUP_MAX=20
